# Staging .env for the MV-6 orchestrator cutover test.  Copy to `.env` in the staging host.
# Goal: an isolated Zenodotus that routes scraping to the orchestrator (USE_ORCHESTRATOR=true)
# WITHOUT touching production data. Do NOT commit the filled-in file.
#
# Legend:  [FILL] real value needed   ·   [GEN] generate once   ·   [DUMMY] any value (staging)

# --- Orchestrator (the point of this test) ---
USE_ORCHESTRATOR=true
MITROPOULOS_URL=https://orchestrator.factcheckinsights.org
# Share of scrapes routed to the orchestrator, 0-100; unset or invalid means none. Staging wants
# all of it. A per-platform variable wins when set, e.g. ORCHESTRATOR_CANARY_PERCENT_TWITTER=0.
# Read by the worker: after changing it, `docker compose up -d worker` (not `restart`).
ORCHESTRATOR_CANARY_PERCENT=100
# The orchestrator authenticates through Keycloak (realm `botalite` on sso.botalite.es). We
# are the confidential client `zenodotus` there; the secret is in Bitwarden. Zenodotus
# exchanges these for a 5-minute token on its own (lib/utilities/mitropoulos_token.rb).
MITROPOULOS_TOKEN_URL=https://sso.botalite.es/realms/botalite/protocol/openid-connect/token
MITROPOULOS_CLIENT_ID=zenodotus
MITROPOULOS_CLIENT_SECRET=                # [FILL] Keycloak → Clients → zenodotus → Credentials
# MITROPOULOS_AUTH_KEY=                   # dev only: static bearer for an orchestrator in
#                                         # AUTH_DEV_TOKEN mode; overrides the three above
# The other direction: the orchestrator calls us back on
# /archive/scrape_result_callback, a route open to the internet. Set this and the
# callback requires `Authorization: Bearer <this>`; leave it empty and the route stays open.
# The SAME value must be set as ZENODOTUS_CALLBACK_TOKEN on the orchestrator (see STAGING.md).
ZENODOTUS_CALLBACK_TOKEN=                 # [GEN] `openssl rand -hex 32`
# Demand the bearer on EVERY callback, not just those for scrapes routed to the orchestrator.
# Only once Hypatia is gone -- with it on during the canary, Hypatia's callbacks all 401.
# ZENODOTUS_CALLBACK_REQUIRED=true

# --- Isolated datastores (provided by docker-compose.staging.yml) ---
DATABASE_URL=postgres://postgres:postgres@db:5432/zenodotus_production
NEO4J_URL=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
MEMCACHIER_SERVERS=memcached:11211
MEMCACHIER_USERNAME=staging               # [DUMMY]
MEMCACHIER_PASSWORD=staging               # [DUMMY]

# --- Staging hostnames (routes are host-constrained; use a domain you control) ---
FACT_CHECK_INSIGHTS_HOST=fci-staging.factcheckinsights.org   # [FILL]
MEDIA_VAULT_HOST=vault-staging.factcheckinsights.org         # [FILL]
PUBLIC_LINK_HOST=links-staging.factcheckinsights.org         # [FILL]
AUTH_BASE_HOST=https://vault-staging.factcheckinsights.org   # [FILL]

# --- Media storage: same GCS bucket production reads (from Bitwarden) ---
AWS_REGION=europe-west4                    # [FILL]
AWS_S3_BUCKET_NAME=mediavault-storage      # [FILL] (or a test bucket)
AWS_ACCESS_KEY_ID=                         # [FILL] (GCS HMAC key)
AWS_SECRET_ACCESS_KEY=                     # [FILL]
S3_ENDPOINT=https://storage.googleapis.com # [FILL]
AWS_S3_BUCKET_NAME_HYPATIA=                # download prefix; leave empty if media are at the bucket root

# --- Rails secrets (generate: `openssl rand -hex 64`) ---
SECRET_KEY_BASE=                           # [GEN]
KEY_ENCRYPTION_SALT=                       # [GEN]
DEVISE_JWT_SECRET_KEY=                     # [GEN]

# --- Hypatia (unused when the orchestrator is on, but Figaro requires the keys) ---
HYPATIA_SERVER_URL=https://unused.example.com   # [DUMMY]
HYPATIA_AUTH_KEY=unused                          # [DUMMY]

# --- Email / captcha / misc (dummy is fine on staging; no real mail/captcha) ---
MAIL_DOMAIN=staging.local                  # [DUMMY]
MAILGUN_API_KEY=dummy                      # [DUMMY]
RECAPTCHA_SITE_KEY=dummy                   # [DUMMY]
RECAPTCHA_PROJECT_ID=dummy                 # [DUMMY]
HONEYBADGER_API_KEY_GOOGLE_CHECK_IN_ADDRESS=dummy         # [DUMMY]
HONEYBADGER_API_KEY_CSV_JSON_GENERATION_ADDRESS=dummy     # [DUMMY]
OLLAMA_URL=                                # [DUMMY] (blank ok)
OLLAMA_PASSWORD=                           # [DUMMY]
FACTCHECK_TOOLS_API_KEY=dummy              # [DUMMY]
VIPS_WARNING=0                             # [DUMMY]
CHROME_EXTENSION_ID=dummy                  # [DUMMY]
